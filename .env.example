JUSTSAYING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-nano
JUSTSAYING_OPTIMIZE_HOTKEY=option+shift
JUSTSAYING_UNDO_HOTKEY=option*3

# Mobile web friend-pass settings. Keep real pass tokens only in local .env.
JUSTSAYING_WEB_SITE_URL=https://mehelper.com/justsaying
JUSTSAYING_WEB_BASE_PATH=/justsaying
JUSTSAYING_WEB_REQUIRE_PASS=true
JUSTSAYING_WEB_DEFAULT_DAILY_LIMIT=100
JUSTSAYING_WEB_DEFAULT_MAX_CHARS=3000
JUSTSAYING_WEB_GLOBAL_DAILY_LIMIT=1000
JUSTSAYING_WEB_PASSES=friend:replace-with-random-token:100:3000:true

# Optional: custom optimizer system prompt. The app settings window writes this for you.
# Use \n for line breaks if editing by hand.
# JUSTSAYING_OPTIMIZE_PROMPT=你是一个语音提示词清洗助手。\n输出只包含整理后的 prompt，不要解释。

# JUSTSAYING_DISABLE_LLM=false
