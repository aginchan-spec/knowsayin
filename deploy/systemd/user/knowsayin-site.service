[Unit]
Description=KnowSayin public website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dnachan/Desktop/knowsayin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/dnachan/.config/knowsayin/site.env
EnvironmentFile=-/home/dnachan/.config/knowsayin/api.env
ExecStart=/home/dnachan/Desktop/knowsayin/.venv/bin/python -m app.site --host 127.0.0.1 --port 8789
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
