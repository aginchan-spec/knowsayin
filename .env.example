KNOWSAYIN_PROVIDER=knowsayin
KNOWSAYIN_CLOUD_BASE_URL=https://api.knowsayin.com
KNOWSAYIN_CLOUD_MODEL=knowsayin-cloud
KNOWSAYIN_CLOUD_TOKEN=
KNOWSAYIN_OPTIMIZE_HOTKEY=option+shift
KNOWSAYIN_UNDO_HOTKEY=option*3

# Optional self-hosted or direct provider settings. The default app flow does not
# need a local API key; KnowSayin Cloud calls the upstream model server-side.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-nano

# KnowSayin cloud API settings for the VM101/server process. Keep real tokens
# only in server environment files, never in the repo or client package.
KNOWSAYIN_API_ALLOWED_ORIGINS=https://knowsayin.com
KNOWSAYIN_API_ANON_DAILY_LIMIT=20
KNOWSAYIN_API_TOKEN_MINUTE_LIMIT=5
KNOWSAYIN_API_IP_HOUR_LIMIT=60
KNOWSAYIN_API_GLOBAL_DAILY_LIMIT=2000
KNOWSAYIN_API_MAX_CHARS=3000
KNOWSAYIN_API_TOKEN_SECRET=replace-with-random-server-secret
KNOWSAYIN_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
KNOWSAYIN_UPSTREAM_MODEL=deepseek-chat
KNOWSAYIN_UPSTREAM_API_KEY=
KNOWSAYIN_DOWNLOAD_URL=https://knowsayin.com/download
KNOWSAYIN_GITHUB_URL=https://github.com/aginchan-spec/knowsayin

# Optional: custom optimizer system prompt. The app settings window writes this for you.
# Use \n for line breaks if editing by hand.
# KNOWSAYIN_OPTIMIZE_PROMPT=You are a voice-to-prompt cleanup assistant.\nRewrite the user's rough spoken text into a clear AI prompt.\nOutput only the cleaned prompt. Do not explain your changes.

# KNOWSAYIN_DISABLE_LLM=false
